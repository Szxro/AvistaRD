      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AvistaRD.Application\AvistaRD.Application.csproj" />
      <ProjectReference Include="..\AvistaRD.Infrastructure\AvistaRD.Infrastructure.csproj" />
    </ItemGroup>

</Project>
