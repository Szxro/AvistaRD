{
  "info": {
    "name": "AvistaRD API",
    "description": "Endpoints de la API de AvistaRD.\n\nAntes de usarla, ajusta la variable `baseUrl` de la colección al puerto con el que corre la API (ver `src/AvistaRD.Api/Properties/launchSettings.json`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7166",
      "type": "string"
    },
    {
      "key": "speciesId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Species",
      "item": [
        {
          "name": "Register species",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created id', () => pm.expect(body.data).to.be.a('number'));",
                  "",
                  "pm.collectionVariables.set('speciesId', body.data);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commonName\": \"Cigua palmera\",\n  \"scientificName\": \"Dulus dominicus\",\n  \"isEndemic\": true,\n  \"isSensible\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/species",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species"]
            },
            "description": "Registra una especie nueva. Devuelve el Id creado en `data`."
          }
        },
        {
          "name": "Register species - duplicate (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commonName\": \"Cigua palmera (duplicada)\",\n  \"scientificName\": \"Dulus dominicus\",\n  \"isEndemic\": true,\n  \"isSensible\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/species",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species"]
            },
            "description": "Mismo nombre científico que una especie existente. Ejecuta primero 'Register species'."
          }
        },
        {
          "name": "Register species - invalid (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Returns validation errors', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commonName\": \"\",\n  \"scientificName\": \"\",\n  \"isEndemic\": false,\n  \"isSensible\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/species",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species"]
            },
            "description": "Campos vacíos: devuelve los errores de validación agrupados por campo."
          }
        }
      ]
    }
  ]
}
